#!/bin/sh
set -e
case "$1" in
    remove|purge)
        # Without the retrigger the access granted by the rule can outlast the package until reboot.
        udevadm control --reload-rules || true
        udevadm trigger --action=change --subsystem-match=misc --sysname-match=uinput || true
        ;;
esac
exit 0
